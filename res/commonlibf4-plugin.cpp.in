#include <F4SE/F4SE.h>
#include "Runtime.h"
F4SE_PLUGIN_VERSION = []() noexcept {
    F4SE::PluginVersionData v{};
    v.PluginVersion({${COMMONLIB_PLUGIN_VERSION_MAJOR}, ${COMMONLIB_PLUGIN_VERSION_MINOR}, ${COMMONLIB_PLUGIN_VERSION_PATCH}, 0});
    v.PluginName("ENBInputDisablerFO4");
    v.UsesAddressLibrary(true);
    v.UsesSigScanning(false);
    v.IsLayoutDependent(true);
    v.HasNoStructUse(false);
    static_assert(ENBInputDisabler::kRuntimes.size() < std::size(v.compatibleVersions));
    for (std::size_t i = 0; i < ENBInputDisabler::kRuntimes.size(); ++i)
        v.compatibleVersions[i] = ENBInputDisabler::kRuntimes[i].pack();
    return v;
}();
